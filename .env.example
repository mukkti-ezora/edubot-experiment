# ---- EduBot environment template ----
# Copy to .env for local overrides. Dev defaults below work out of the box.
# NEVER commit a real .env or real secrets.

# Cryptographic signing for access tokens (HS256 dev; RS256 planned for production).
EDUBOT_JWT_SECRET=dev-insecure-jwt-secret-change-me-0123456789

# Shared internal token used between gateway and services (defense-in-depth at the internal API boundary).
EDUBOT_INTERNAL_TOKEN=dev-insecure-internal-token-change-me

# Database (see docker-compose.yml)
IDENTITY_DATABASE_URL=postgresql+asyncpg://edubot:edubot@localhost:5433/identity_db
TENANCY_DATABASE_URL=postgresql+asyncpg://edubot:edubot@localhost:5433/tenancy_db
USERS_DATABASE_URL=postgresql+asyncpg://edubot:edubot@localhost:5433/users_db
RBAC_DATABASE_URL=postgresql+asyncpg://edubot:edubot@localhost:5433/rbac_db
AUDIT_DATABASE_URL=postgresql+asyncpg://edubot:edubot@localhost:5433/audit_db

# Service base URLs used by the gateway / inter-service calls
IDENTITY_URL=http://localhost:8001
TENANCY_URL=http://localhost:8002
USERS_URL=http://localhost:8003
RBAC_URL=http://localhost:8004
AUDIT_URL=http://localhost:8005

# Auth policy (documented defaults; surfaced read-only in Settings)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Development seed administrator (dev convenience only; clearly synthetic)
EDUBOT_SEED_ADMIN_EMAIL=sysadmin@edubot.example.edu
EDUBOT_SEED_ADMIN_PASSWORD=ChangeMe-admin-234!
EDUBOT_SEED_ROLE_PASSWORD=EduBot-demo-2026!

# Web: optional one-click demo sign-in on the login page (apps/web/.env, never in production)
VITE_DEMO_ADMIN_PASSWORD=ChangeMe-admin-234!
VITE_DEMO_ROLE_PASSWORD=EduBot-demo-2026!

# Identity: sign-in session records are rotated out this many days after they end or go idle
SESSION_RETENTION_DAYS=60

# Learning service + EduBot Tutor
LEARNING_DATABASE_URL=postgresql+asyncpg://edubot:edubot@localhost:5433/learning_db
LEARNING_TRAIL_RETENTION_DAYS=60
# anthropic | openai; an institution can override this in institution_tutor_settings
TUTOR_DEFAULT_PROVIDER=anthropic
TUTOR_MESSAGES_PER_MINUTE=8
TUTOR_MESSAGES_PER_DAY=200
# Provider keys are read by the official SDKs. Leave blank to run with the tutor shown as unavailable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Doubts: reply target and fair-use caps
DOUBT_REPLY_HOURS=48
DOUBTS_PER_DAY=10
DOUBT_FOLLOW_UPS_PER_DAY=30
DOUBT_MESSAGES_MAX=50
DOUBT_DRAFTS_PER_MINUTE=5
DOUBT_DRAFT_MAX_TOKENS=800
# Files, practice, coursework, attendance
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENTS_PER_DAY=60
AI_PRACTICE_PER_DAY=20
AI_PRACTICE_MAX_TOKENS=3000
DOUBT_DRAFTS_PER_DAY=100
EXTENSION_AUTO_APPROVE_HOURS=48
ATTENDANCE_THRESHOLD_PERCENT=75
CHECKIN_WINDOW_MINUTES=10
INSTITUTION_TIMEZONE=Asia/Kolkata
